Screen {
    background: #0d1117;
    color: #e6edf3;
    align-horizontal: center;
}

#status {
    height: 3;
    padding: 1 2;
    color: #8b949e;
    background: #161b22;
}

#study-card, #setup-card {
    width: 76;
    max-width: 96%;
    min-height: 18;
    height: auto;
    margin: 2 0;
    padding: 1 3;
    border: round #30363d;
    background: #161b22;
}

#setup-card {
    min-height: 18;
}

#setup-title, #pause-title, #reset-title {
    text-style: bold;
    color: #58a6ff;
    margin-bottom: 1;
}

#self-form {
    height: 5;
    margin: 1 0;
}

#setup-error {
    color: #ff7b72;
    height: 2;
}

#save-setup {
    margin-top: 1;
}

#phase {
    height: 2;
    color: #58a6ff;
    text-style: bold;
}

#context {
    min-height: 2;
    color: #8b949e;
    margin-top: 1;
}

#prompt {
    min-height: 3;
    margin-top: 1;
    text-style: bold;
}

#model {
    min-height: 3;
    margin: 1 0;
    color: #7ee787;
    text-style: bold;
}

#answer {
    margin-top: 1;
    border: tall #58a6ff;
}

#feedback {
    min-height: 3;
    margin-top: 1;
    color: #d2a8ff;
}

#keys {
    dock: bottom;
    height: 3;
    padding: 1 2;
    color: #8b949e;
    background: #161b22;
    text-align: center;
}

PauseScreen, ResetProgressScreen {
    align: center middle;
    background: #000000 55%;
}

#pause-card {
    width: 52;
    height: 12;
    padding: 1 2;
    border: round #58a6ff;
    background: #161b22;
    align-horizontal: center;
}

#pause-error {
    height: 3;
    color: #ff7b72;
}

#reset-card {
    width: 64;
    max-width: 94%;
    height: 16;
    padding: 1 2;
    border: round #ff7b72;
    background: #161b22;
}

#reset-warning {
    height: 4;
    color: #ff7b72;
}

#reset-confirmation {
    margin-top: 1;
}

#reset-help {
    color: #8b949e;
}

#reset-error {
    height: 2;
    color: #ff7b72;
}
